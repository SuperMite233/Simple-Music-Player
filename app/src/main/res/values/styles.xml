<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">#006B58</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#9DF2D5</item>
        <item name="colorOnPrimaryContainer">#002117</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppTheme.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">#006B58</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#9DF2D5</item>
        <item name="colorOnPrimaryContainer">#002117</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">#81D5B9</item>
        <item name="colorOnPrimary">#00382B</item>
        <item name="colorPrimaryContainer">#00513F</item>
        <item name="colorOnPrimaryContainer">#9DF2D5</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Dialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog" />
    <style name="AppTheme.Dialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog" />
</resources>
